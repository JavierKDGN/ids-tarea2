# Copiar a .env (compose lee .env, no .env.example): cp .env.example .env

# Resiliencia sobre Pagos -> Pasarela
PASARELA_TIMEOUT=1.0
CB_FAILURE_THRESHOLD=2
CB_RECOVERY_SECONDS=4
BULKHEAD_MAX_CONCURRENT=2

# Timeout de la saga hacia Habitaciones/Pagos/Confirmaciones
SERVICES_TIMEOUT=2.5

# TEMPORAL (hasta que exista el gateway, paso 2): puerto del host donde se publica la saga
SAGA_HOST_PORT=8000
