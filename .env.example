# Copiar a .env (compose lee .env, no .env.example): cp .env.example .env

# Resiliencia sobre Pagos -> Pasarela
PASARELA_TIMEOUT=1.0
# Reintentos con backoff exponencial solo cuando la pasarela confirma que NO cobro (0 los desactiva)
PASARELA_REINTENTOS=0
PASARELA_BACKOFF_S=0.2
CB_FAILURE_THRESHOLD=2
CB_RECOVERY_SECONDS=4
BULKHEAD_MAX_CONCURRENT=10

# Timeout de la saga hacia Habitaciones/Pagos/Confirmaciones
SERVICES_TIMEOUT=2.5

# Cada cuantos segundos la saga reintenta sola las reservas pendientes (0 la desactiva)
RECONCILIACION_SEGUNDOS=20

# BFF: espera maxima por cada fuente (saga, habitaciones, confirmaciones)
BFF_TIMEOUT=2.0

# Gateway: tokens "cliente:token" separados por coma, limite por cliente y puerto publicado en el host
GATEWAY_TOKENS=demo:demo-token
RATE_LIMIT_PER_MINUTE=60
GW_HOST_PORT=8080
